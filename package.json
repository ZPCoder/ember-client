{
  "name": "@zpcoder/ember-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cocos Creator 3.8.8 client, React protocol reference, and temporary Flutter save exporter for Ember Protocol.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "creator": {
    "version": "3.8.8"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts tools/flutter-save-exporter/tests/*.test.ts && node scripts/static-check.mjs",
    "test:core": "node --experimental-strip-types --test tests/*.test.ts",
    "test:migration": "node --experimental-strip-types --test tools/flutter-save-exporter/tests/*.test.ts",
    "check:static": "node scripts/static-check.mjs",
    "typecheck:ci": "tsc -p tsconfig.ci.json --noEmit",
    "changeset": "npx --yes @changesets/cli@2.29.8",
    "version-packages": "npx --yes @changesets/cli@2.29.8 version"
  },
  "peerDependencies": {
    "@zpcoder/ember-config": "^0.1.0",
    "@zpcoder/ember-protocol": "^0.1.0",
    "@zpcoder/ember-sdk": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@zpcoder/ember-config": {
      "optional": true
    },
    "@zpcoder/ember-protocol": {
      "optional": true
    },
    "@zpcoder/ember-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.8",
    "@types/node": "22.19.19",
    "typescript": "4.9.5"
  }
}
